{
  "name": "external-app-data-discovery-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "对外APP问数找数买数交互原型（移动端 + PC运营后台），Vue3 + Vite + TypeScript + Pinia",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "vue-tsc -b --noCheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.4.38",
    "vue-router": "^4.4.3",
    "pinia": "^2.2.2",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.0.29"
  }
}
