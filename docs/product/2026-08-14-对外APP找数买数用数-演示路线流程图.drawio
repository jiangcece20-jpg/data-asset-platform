        <mxCell id="fa-a4" value="A4 查看唯一价格、固定周期&#xa;许可与席位" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fa1"><mxGeometry x="1610" y="290" width="260" height="100" as="geometry"/></mxCell>
