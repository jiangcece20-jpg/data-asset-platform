        <mxCell id="ov-note-space" value="可信空间成交：B&#xa;价格、订单、交付与售后以空间事实为准" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F1EEFF;strokeColor=#6D55B5;strokeWidth=2;fontColor=#4B3B82;fontSize=15;fontStyle=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="1"><mxGeometry x="1300" y="970" width="680" height="100" as="geometry"/></mxCell>
        <mxCell id="ov-footer" value="阅读方式：先看总览确定成交边界，再进入 A～E 详细页核对角色、判断和状态。" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#64748B;fontSize=15;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="1"><mxGeometry x="240" y="1140" width="1920" height="40" as="geometry"/></mxCell>
