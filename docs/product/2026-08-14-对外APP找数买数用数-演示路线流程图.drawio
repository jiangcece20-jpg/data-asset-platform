  <diagram id="flow-a-delivery" name="flow-a-delivery">
    <mxGraphModel dx="2400" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1350" math="0" shadow="0" background="#F8FAFC">
      <root>
        <mxCell id="fad0"/><mxCell id="fad1" parent="fad0"/>
        <mxCell id="fad-title" value="流程 A-2｜APP 数据集交付、失败重试与续订" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#2D3748;fontSize=20;fontStyle=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="60" y="30" width="2280" height="50" as="geometry"/></mxCell>
        <mxCell id="fad-rule" value="三轴状态始终独立：交付失败不能把“已支付”回退为“待支付”" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF8E8;strokeColor=#E99151;strokeWidth=2;fontColor=#7A431A;fontSize=15;fontStyle=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="650" y="100" width="1100" height="70" as="geometry"/></mxCell>
        <mxCell id="fad-lane-user" value="企业管理员 / 成员" style="swimlane;horizontal=0;startSize=50;rounded=1;html=0;fillColor=#EAF3FF;swimlaneFillColor=#F8FBFF;strokeColor=#155CB0;strokeWidth=2;fontColor=#155CB0;fontSize=15;fontStyle=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="70" y="210" width="2260" height="300" as="geometry"/></mxCell>
        <mxCell id="fad-lane-app" value="APP / 交付服务" style="swimlane;horizontal=0;startSize=50;rounded=1;html=0;fillColor=#F1EEFF;swimlaneFillColor=#FBFAFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#6D55B5;fontSize=15;fontStyle=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="70" y="540" width="2260" height="480" as="geometry"/></mxCell>
        <mxCell id="fad-paid" value="已支付订单" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#4CA497;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="130" y="660" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="fad-a8" value="A8 查看首次交付失败" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="390" y="310" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="fad-axes" value="付款=已支付&#xa;权益=处理中&#xa;交付=交付失败" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DC2626;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="690" y="630" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="fad-a9" value="A9 发起交付重试" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="980" y="310" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="fad-retrying" value="交付=重试中&#xa;付款、权益状态不变" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E99151;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="1270" y="650" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="fad-decision" value="交付成功？" style="rhombus;whiteSpace=wrap;html=0;fillColor=#005D7B;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="1570" y="630" width="180" height="140" as="geometry"/></mxCell>
        <mxCell id="fad-a10" value="A10 权益有效&#xa;交付完成" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#4CA497;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="1820" y="640" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="fad-use" value="进入用数或下载" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="2100" y="310" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="fad-fail" value="仍失败：保持已支付事实&#xa;允许后续处理" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FCECEF;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;fontSize=15;fontStyle=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="1530" y="840" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="fad-a14" value="A14 周期临近结束或已结束" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="2010" y="420" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="fad-stop" value="停止更新&#xa;保留最近有效版本" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="2040" y="820" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="fad-renew" value="按最新价格与最新商品周期续订&#xa;新订单重新锁定周期" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#4CA497;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="1760" y="890" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="fad-note" value="重试幂等；处理中禁止重复触发；成功不重复发权" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF8E8;strokeColor=#E99151;strokeWidth=2;fontColor=#7A431A;fontSize=15;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fad1"><mxGeometry x="700" y="1080" width="1000" height="70" as="geometry"/></mxCell>
        <mxCell id="fad-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeWidth=2;strokeColor=#94A3B8;endArrow=block;endFill=1;" edge="1" source="fad-paid" target="fad-a8" parent="fad1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fad-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeWidth=2;strokeColor=#DC2626;endArrow=block;endFill=1;" edge="1" source="fad-a8" target="fad-axes" parent="fad1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fad-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeWidth=2;strokeColor=#94A3B8;endArrow=block;endFill=1;" edge="1" source="fad-axes" target="fad-a9" parent="fad1"><mxGeometry relative="1" as="geometry"/></mxCell>
