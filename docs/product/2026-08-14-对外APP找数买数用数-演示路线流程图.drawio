        <mxCell id="fa-a2" value="A2 查看样例、字段&#xa;与探查报告" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fa1"><mxGeometry x="730" y="295" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="fa-a3" value="A3 选择企业或个人&#xa;购买主体" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fa1"><mxGeometry x="1020" y="295" width="240" height="90" as="geometry"/></mxCell>
