        <mxCell id="fa-lane-app" value="APP" style="swimlane;horizontal=0;startSize=50;rounded=1;html=0;fillColor=#F1EEFF;swimlaneFillColor=#FBFAFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#6D55B5;fontSize=15;fontStyle=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fa1"><mxGeometry x="70" y="500" width="2260" height="260" as="geometry"/></mxCell>
        <mxCell id="fa-lane-enterprise" value="企业采购" style="swimlane;horizontal=0;startSize=50;rounded=1;html=0;fillColor=#FFF1E5;swimlaneFillColor=#FFFBF7;strokeColor=#E99151;strokeWidth=2;fontColor=#B45309;fontSize=15;fontStyle=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fa1"><mxGeometry x="70" y="790" width="2260" height="260" as="geometry"/></mxCell>
        <mxCell id="fa-a1" value="A1 搜索“货车轨迹”" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontSize=15;shadow=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fa1"><mxGeometry x="150" y="300" width="230" height="80" as="geometry"/></mxCell>
