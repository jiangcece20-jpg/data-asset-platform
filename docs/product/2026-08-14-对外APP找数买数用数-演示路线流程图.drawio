        <mxCell id="fad-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeWidth=2;strokeColor=#94A3B8;endArrow=block;endFill=1;" edge="1" source="fad-retrying" target="fad-decision" parent="fad1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fad-e6" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeWidth=2;strokeColor=#4CA497;endArrow=block;endFill=1;labelBackgroundColor=#F8FAFC;fontColor=#23834B;fontSize=15;" edge="1" source="fad-decision" target="fad-a10" parent="fad1"><mxGeometry relative="1" as="geometry"/></mxCell>
