        <mxCell id="fa-rule-1" value="固定周期：用户不能选择周期或数据截止日期" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF8E8;strokeColor=#E99151;strokeWidth=2;fontColor=#7A431A;fontSize=15;fontStyle=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;" vertex="1" parent="fa1"><mxGeometry x="280" y="100" width="780" height="70" as="geometry"/></mxCell>
